# Copy to backend/.env for local development. Never commit real values.
APP_ENV=development
# SQLite for local development; any postgres:// or postgresql:// URL works (Neon, Vercel Postgres).
DATABASE_URL=sqlite:///./ssdlc.db
# Must be identical to AUTH_SECRET in the frontend. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated list of browser origins allowed to call the API (the frontend URL, no trailing slash).
CORS_ORIGINS=http://localhost:3000
# Optional: enables Claude analysis. Without it the free keyword heuristic is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
# Hosts the API may download Blob uploads from (SSRF allow-list).
BLOB_ALLOWED_HOSTS=.public.blob.vercel-storage.com
MAX_DIRECT_UPLOAD_MB=4
MAX_BLOB_UPLOAD_MB=50
