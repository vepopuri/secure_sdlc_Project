# Copy to frontend/.env.local for local development. Never commit real values.
# Must be identical to AUTH_SECRET in the backend. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# URL of the FastAPI backend (no trailing slash). Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# OAuth providers (configure at least one in production)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local testing only: e-mail login without OAuth. Always disabled on Vercel deployments.
ENABLE_DEV_LOGIN=true
# Needed when running `next start` outside Vercel.
AUTH_TRUST_HOST=true

# Optional: Vercel Blob for uploads larger than 4 MB (added automatically when you connect a Blob store).
BLOB_READ_WRITE_TOKEN=

# Optional branding: official logo file placed in public/brand/
NEXT_PUBLIC_BRAND_LOGO=
NEXT_PUBLIC_BRAND_NAME=
