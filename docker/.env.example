# Environment for the all-in-one container. Copy to .env next to docker-compose.yml.
# Every value is optional; the container runs with none of them set.

# Public URL of the site (needed for OAuth callbacks behind a domain), e.g. https://ssdlc.example.com
AUTH_URL=

# Sign-in. Configure at least one provider for a real deployment.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Trial only: e-mail login without OAuth. Anyone who can reach the site can sign in as anyone.
ENABLE_DEV_LOGIN=true

# Claude analysis. Empty = free keyword heuristic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Leave empty to use the embedded PostgreSQL (data in the /data volume),
# or point to an external database such as Neon (postgres:// or postgresql://).
DATABASE_URL=

# Leave empty to auto-generate (stored in /data/auth_secret).
AUTH_SECRET=
